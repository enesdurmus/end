{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "End",
  "version": "0.2.0",
  "identifier": "com.enesdurmus.end",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "width": 700,
        "height": 460,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "preferences",
        "title": "Preferences",
        "width": 420,
        "height": 440,
        "center": true,
        "visible": false,
        "resizable": false,
        "transparent": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 10
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MEJCNUQ4NUY2MEE2REUKUldUZXBtQmYyTFVMNU4vL1JZcFU0WkUxZmU5V25TSHBJVldYVTZTTFdFRHFTU1JrNEZDcVd3MWEK",
      "endpoints": [
        "https://github.com/enesdurmus/End/releases/latest/download/latest.json"
      ]
    }
  }
}
